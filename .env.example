# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# Gerçek .env commit EDİLMEZ (.gitignore'da).

# --- Groq (OPSİYONEL) ---------------------------------------------------------
# Boş bırakılabilir. Anahtar yoksa yalnızca serbest metin sohbeti
# (/api/v1/agent/query) devre dışı kalır ve 503 döner; arayüz, rasyon
# optimizasyonu, yem listesi, fiyat senkronu ve RAG araması normal çalışır.
# Ücretsiz anahtar: https://console.groq.com
GROQ_API_KEY=
# Boşsa openai/gpt-oss-120b. Groq bir modeli kaldırırsa (404 model_not_found)
# kod değiştirmeden buradan başka bir modele geçilir.
GROQ_MODEL=

# --- Veritabanı ---------------------------------------------------------------
# Docker compose bu değişkenleri kullanır ve backend'e Postgres URL'ini kendisi kurar.
POSTGRES_USER=rationai
POSTGRES_PASSWORD=rationai
POSTGRES_DB=rationai

# Docker KULLANMADAN (quickstart.py ile) çalıştırırken geçerli olan yereldeki ayar.
# Compose bu satırı yok sayar; konteynerde DATABASE_URL docker-compose.yml'de kurulur.
DATABASE_URL=sqlite:///rationai.db

# --- Loglama ------------------------------------------------------------------
# DEBUG, ajanın istek başına ayrıntılı izini açar.
LOG_LEVEL=INFO
