# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# Gerçek .env commit EDİLMEZ (.gitignore'da).

# --- Sohbet (LLM) — OPSİYONEL --------------------------------------------------
# Boş bırakılabilir. Anahtar yoksa yalnızca sohbet (/api/v1/agent/query) 503 döner;
# hesap ekranları, fiyat senkronu ve bilgi bankası araması normal çalışır.
# Anahtarı olan ilk sağlayıcı kullanılır (sıra: nvidia, groq); LLM_PROVIDER ile seçilebilir.
#
# NVIDIA NIM — ücretsiz, ~40 istek/dk: https://build.nvidia.com ("Get API Key")
# ⚠️ Ücretsiz katman geliştirme/deneme içindir; gerçek kullanıcılara açılan üründe lisans ister.
NVIDIA_API_KEY=
# Groq — ücretsiz, ~8000 token/dk: https://console.groq.com
GROQ_API_KEY=
# nvidia | groq (boşsa anahtarı olan ilk sağlayıcı)
LLM_PROVIDER=
# Boşsa sağlayıcının varsayılanı: nvidia/nemotron-3.5-super-vl-120b-a12b ya da
# openai/gpt-oss-120b. Model kaldırılırsa (404) kod değiştirmeden buradan değiştirilir.
LLM_MODEL=

# --- Veritabanı ---------------------------------------------------------------
# Docker compose bu değişkenleri kullanır ve backend'e Postgres URL'ini kendisi kurar.
POSTGRES_USER=rationai
POSTGRES_PASSWORD=rationai
POSTGRES_DB=rationai

# Docker KULLANMADAN (quickstart.py ile) çalıştırırken geçerli olan yereldeki ayar.
# Compose bu satırı yok sayar; konteynerde DATABASE_URL docker-compose.yml'de kurulur.
DATABASE_URL=sqlite:///rationai.db

# --- Fiyatlar -----------------------------------------------------------------
# Backend günde bir kez yem, canlı hayvan ve karkas fiyatlarını borsadan kendisi çeker.
# 0 kapatır (çevrimdışı çalışma, testler).
PRICE_AUTO_SYNC=1

# --- Loglama ------------------------------------------------------------------
# DEBUG, ajanın istek başına ayrıntılı izini açar.
LOG_LEVEL=INFO
